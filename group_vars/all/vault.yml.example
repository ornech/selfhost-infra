---
# Copier en vault.yml, remplir, puis : ansible-vault encrypt group_vars/all/vault.yml
# Ne JAMAIS committer vault.yml en clair (la CI le refuse).

# Contenu du fichier d'identifiants du plugin certbot DNS choisi
# (/etc/letsencrypt/dns-<plugin>.ini, mode 0600). Clés propres à chaque plugin.
# Cloudflare (plugin par défaut) : jeton d'API limité à la seule zone.
#   droits utilisés lors des tests : Zone → DNS → Edit et Zone → Zone → Read
# Le plugin OVH n'existe pas dans Debian 13 (voir certbot_dns_plugin).
vault_certbot_dns_credentials: |
  dns_cloudflare_api_token = changeme

# Secrets des applications : nom du secret Podman -> valeur.
# Utilisés dans les unités Quadlet via Secret=<nom>.
vault_app_secrets: {}
#   app_db_password: "changeme"

# --- Sauvegardes (restic) ---------------------------------------------------
# Clé de chiffrement des dépôts : SANS ELLE, AUCUNE RESTAURATION POSSIBLE.
# La conserver aussi HORS du serveur (gestionnaire de mots de passe, papier).
vault_restic_password: "changeme"
# Compte du serveur sauvegardé sur rest-server (cible hors site)
vault_backup_rest_user: "selfhost"
vault_backup_rest_password: "changeme"
