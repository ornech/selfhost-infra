# {{ ansible_managed }}
[Unit]
Description=Service de démo protégé par Authelia

[Container]
ContainerName=whoami
Image={{ images.whoami }}
Exec=--port 8080 --name service-protege
Network=stack-backend.network
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always

[Install]
WantedBy=default.target
