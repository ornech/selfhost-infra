# {{ ansible_managed }}
{
	email {{ acme_email }}
	order crowdsec first
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_KEY}
	}
	servers {
		protocols h1 h2 h3
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

# Un seul certificat wildcard (DNS-01) : les sous-domaines n'apparaissent
# pas individuellement dans les journaux Certificate Transparency.
*.{{ domain }}, {{ domain }} {
	tls {
		dns {{ caddy_dns_block | indent(8) }}
	}
	import securite
	crowdsec

	@apex host {{ domain }}
	handle @apex {
		redir https://www.{{ domain }}{uri} permanent
	}

	@auth host auth.{{ domain }}
	handle @auth {
		reverse_proxy authelia:9091
	}

{% for h in public_hosts %}
	@{{ h.name }} host {{ h.name }}.{{ domain }}
	handle @{{ h.name }} {
		reverse_proxy {{ h.upstream }}
	}

{% endfor %}
{% for h in protected_hosts %}
	@{{ h.name }} host {{ h.name }}.{{ domain }}
	handle @{{ h.name }} {
		import authelia
		reverse_proxy {{ h.upstream }}
	}

{% endfor %}
	# Tout sous-domaine inconnu : connexion fermée, aucune information
	handle {
		abort
	}
}
