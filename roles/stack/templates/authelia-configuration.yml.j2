# {{ ansible_managed }}
# Authelia 4.39 — configuration minimale (fichier local, SQLite, notifications fichier)
# Aucun secret ici : voir authelia.container (Secret= + variables *_FILE)
server:
  address: 'tcp://:9091/'

log:
  level: info

theme: auto

authentication_backend:
  password_reset:
    disable: true
  file:
    path: /config/users.yml
    password:
      algorithm: argon2

totp:
  issuer: '{{ domain }}'

access_control:
  default_policy: deny
  rules:
{% for h in protected_hosts %}
    - domain: '{{ h.name }}.{{ domain }}'
      policy: two_factor
{% endfor %}

# Secrets (jwt, session, storage) : injectés par secrets Podman via *_FILE
session:
  cookies:
    - domain: '{{ domain }}'
      authelia_url: 'https://auth.{{ domain }}'
      default_redirection_url: 'https://www.{{ domain }}'

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 15m

storage:
  local:
    path: /config/db.sqlite3

# En test : les codes d'enregistrement TOTP sont écrits ici
# (cat ~stack/stack/authelia/notification.txt)
notifier:
  filesystem:
    filename: /config/notification.txt
