# {{ ansible_managed }}
[Unit]
Description=Caddy (seul point d'entrée exposé)
Wants=crowdsec.service authelia.service
After=crowdsec.service authelia.service

[Container]
ContainerName=caddy
Image=localhost/caddy-custom:{{ caddy_version }}
Network=stack-egress.network
Network=stack-backend.network
Network=stack-sec.network
# Les SEULS ports publiés de toute la stack
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
Secret=crowdsec_bouncer_key,type=env,target=CROWDSEC_BOUNCER_KEY
{% for k in caddy_dns_env_keys %}
Secret=dns_{{ k | lower }},type=env,target={{ k }}
{% endfor %}
Volume={{ stack_dir }}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume={{ stack_dir }}/caddy/logs:/var/log/caddy
Volume=caddy-data:/data
Volume=caddy-config:/config

[Service]
Restart=always

[Install]
WantedBy=default.target
