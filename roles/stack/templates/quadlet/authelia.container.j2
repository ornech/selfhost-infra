# {{ ansible_managed }}
[Unit]
Description=Authelia (SSO + 2FA devant les services protégés)

[Container]
ContainerName=authelia
Image={{ images.authelia }}
Network=stack-backend.network
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
# Les secrets ne sont pas dans configuration.yml : ils sont montés en fichiers
Secret=authelia_jwt_secret
Secret=authelia_session_secret
Secret=authelia_storage_key
Environment=AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/run/secrets/authelia_jwt_secret
Environment=AUTHELIA_SESSION_SECRET_FILE=/run/secrets/authelia_session_secret
Environment=AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/run/secrets/authelia_storage_key
Volume={{ stack_dir }}/authelia:/config

[Service]
Restart=always

[Install]
WantedBy=default.target
